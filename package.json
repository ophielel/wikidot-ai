{
  "name": "@ukwhatn/wikidot",
  "version": "4.5.3",
  "description": "TypeScript library for interacting with Wikidot sites",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    }
  },
  "files": [
    "dist",
    "dist-agent",
    "docs",
    "agent/README.md"
  ],
  "bin": {
    "wikidot-ai": "./dist-agent/cli.js"
  },
  "scripts": {
    "build": "bunup",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "test:unit": "bun test tests/unit/",
    "test:unit:cov": "bun test tests/unit/ --coverage",
    "test:integration": "bun test tests/integration/",
    "test:integration:cov": "bun test tests/integration/ --coverage",
    "agent": "tsx agent/src/cli.ts",
    "agent:dev": "tsx agent/src/cli.ts",
    "agent:serve": "tsx agent/src/cli.ts serve",
    "agent:build": "tsup --config agent/tsup.config.ts",
    "agent:typecheck": "tsc -p agent/tsconfig.json",
    "agent:test": "node --import tsx --test agent/test/*.test.ts",
    "prepublishOnly": "bun run build && bun run agent:build"
  },
  "keywords": [
    "wikidot",
    "scp",
    "api",
    "client"
  ],
  "author": "ukwhatn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ophielel/wikidot-ai.git"
  },
  "bugs": {
    "url": "https://github.com/ophielel/wikidot-ai/issues"
  },
  "homepage": "https://github.com/ophielel/wikidot-ai#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ky": "^2.0.0",
    "neverthrow": "^8.2.0",
    "p-limit": "^7.3.0",
    "undici": "^8.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "^1.3.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.10.0",
    "bunup": "^0.16.31",
    "jsdom": "^29.1.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6"
  }
}
